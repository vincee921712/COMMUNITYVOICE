# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Microservice URL (FastAPI)
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Default Map Center (Barangay Hibao-an Sur, Mandurriao, Iloilo City)
NEXT_PUBLIC_DEFAULT_LAT=10.7314
NEXT_PUBLIC_DEFAULT_LNG=122.5228

# SMS Mode (test or live)
NEXT_PUBLIC_SMS_MODE=test
SEMAPHORE_API_KEY=your_semaphore_key_here

